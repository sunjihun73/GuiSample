# nginx vhost 기준 주소 (브라우저가 실제로 접속하는 주소)
APP_URL=http://mytechtest.jihun.com
KEYCLOAK_URL=http://keycloak.jihun.com
LITELLM_URL=http://litellm.jihun.com

# Keycloak realm 및 테스트 전용 계정
KEYCLOAK_REALM= MyTechTestSite
E2E_USER= sunjeehun
E2E_PASSWORD=

# pgvector 컨테이너 (TCP 생존 확인용)
PG_HOST=127.0.0.1
PG_PORT=5432

# 앱 생존 확인에 쓸 경로 (actuator 사용)
APP_HEALTH_PATH=/actuator/health

# Spring Security OAuth2 Login 진입 경로.
# application.yml의 registration 이름에 맞춘다.
LOGIN_START_PATH=/oauth2/authorization/keycloak

# RAG 채팅 화면 경로
CHAT_PATH=/user/rag

